<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'job-net-menu-title'}"
    MinSize="750 470"
    SetSize="750 470">
    <BoxContainer Orientation="Vertical" Access="Public" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'job-net-menu-account-balance'}"
              StyleClasses="LabelKeyText" />
            <Label Name="AccountBalanceLabel" Text="" />
        </BoxContainer>
        <TabContainer Name="MasterTabContainer"  VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Access="Public" Margin="10 10 10 10">
                <BoxContainer Orientation="Horizontal" >
                    <Label Text="{Loc 'job-net-menu-working-for'}" Margin="0 0 10 0"
                         StyleClasses="LabelKeyText" />
                    <OptionButton Name="PossibleJobs" Access="Public"/>
                </BoxContainer>
                <Control VerticalExpand ="True"/>
                <BoxContainer Name="AssignmentDetails" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'job-net-menu-current-assignment'}" Margin="0 0 10 0"
                           StyleClasses="LabelKeyText" />
                        <Label Name="CSLabel" Text="{Loc 'job-net-menu-off-duty'}" Margin="0 0 10 0" />
                    </BoxContainer>
                    <Control MinHeight ="30" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'job-net-menu-wage'}" Margin="0 0 10 0"
                          StyleClasses="LabelKeyText" />
                        <Label Name="WageLabel" Text="$0" Margin="0 0 5 0" />
                        <Label Text="{Loc 'job-net-menu-every-20-min'}" Margin="0 0 10 0" />
                    </BoxContainer>
                    <Control MinHeight ="30" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'job-net-menu-next-pay'}" Margin="0 0 10 0"
                         StyleClasses="LabelKeyText" />
                        <Label Name="TimeLabel" Text="0" Margin="0 0 5 0" />
                    </BoxContainer>
                    <Control MinHeight ="30" />
                    <BoxContainer Orientation="Horizontal" Name="SLDetails">
                        <Label Text="{Loc 'job-net-menu-spending-limit'}" Margin="0 0 10 0"
                          StyleClasses="LabelKeyText" />
                        <Label Name="SpendingLabel" Text="$0/$100" Margin="0 0 5 0" />
                    </BoxContainer>
                    <Control MinHeight ="30" />
                    <BoxContainer Orientation="Horizontal" Name="RumorTaxDetails">
                        <Label Text="{Loc 'job-net-menu-rumor-tax'}" Margin="0 0 10 0" StyleClasses="LabelKeyText" />
                        <Label Name="RumorTaxLabel" Text="0%" Margin="0 0 5 0" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Access="Public">
                <TabContainer Name="HistoryTabContainer"  VerticalExpand="True">
                    <ScrollContainer Name="Codex" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical">
                            <TabContainer VerticalExpand="True" HorizontalExpand="True" Name="CodexCategoryTC">
                            </TabContainer>
                        </BoxContainer>
                    </ScrollContainer>
                    <ScrollContainer Name="Insights" VerticalExpand="True" HorizontalExpand="True" VScrollEnabled="False">
                        <BoxContainer Orientation="Vertical">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'job-net-menu-unspent-insights'}" StyleClasses="LabelKeyText" />
                                <RichTextLabel Name="InsightPoints" Text="0" />
                                <Control HorizontalExpand="True" />
                                <Label Text="{Loc 'job-net-menu-codex-unlocks-required'}" StyleClasses="LabelKeyText" />
                                <ProgressBar Name="LevelBar"
                                    HorizontalExpand="True"
                                    MaxValue="1"
                                    MinValue="0"
                                    SetHeight="25"
                                    Margin="10 5 10 5"
                                    VerticalAlignment="Center">
                                    <RichTextLabel Name="ContentLabel" Margin="10 0 0 0" Text="0 / 5" />
                                </ProgressBar>
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True" Name="InsightsBox" />
                        </BoxContainer>
                    </ScrollContainer>
                </TabContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" VerticalExpand="True">
                <TabContainer Name="SectorTabContainer" VerticalExpand="True">
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Name="Status">
                        <BoxContainer Orientation="Vertical" Margin="15">
                            <Label Text="{Loc 'job-net-menu-sector-status-title'}"
                                  StyleClasses="LabelKeyText" />
                            <PanelContainer StyleClasses="BackgroundPanel" HorizontalExpand="True" VerticalExpand="True" Margin="10 10 10 0">
                                <RichTextLabel Name="SectorStatusLabel" />
                            </PanelContainer>
                        </BoxContainer>
                    </ScrollContainer>
                    <ScrollContainer Name="Achievements" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" Access="Public">
                            <Label Text="{Loc 'job-net-menu-ongoing'}" Margin="10 10 10 0"
                                     StyleClasses="LabelKeyText" />
                            <BoxContainer Name="CurrentObjectives" Orientation="Vertical" Access="Public">
                            </BoxContainer>
                            <Label Text="{Loc 'job-net-menu-completed'}" Margin="10 10 10 0"
                                     StyleClasses="LabelKeyText" />
                            <BoxContainer Name="CompletedObjectives" Orientation="Vertical" Access="Public">
                            </BoxContainer>
                        </BoxContainer>
                    </ScrollContainer>
                </TabContainer>
            </BoxContainer>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical" Margin="15">
                    <Control MinHeight="5"/>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'job-net-menu-current-network-level'}"
                          StyleClasses="LabelKeyText" />
                        <Control MinWidth="20"/>
                        <Label Name="CurrentLevelLabel" Text="{Loc 'job-net-menu-small-faction'}" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" MinHeight="100">
                        <PanelContainer VerticalExpand="True"
                                        HorizontalExpand="True"
                                   SizeFlagsStretchRatio="1"
                                   Name="CurrentLevelDescPC">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#000000" />
                            </PanelContainer.PanelOverride>
                            <RichTextLabel Name="CurrentBenefitsLabel" VerticalExpand="True" HorizontalExpand="True" MinHeight="100"/>
                        </PanelContainer>
                    </BoxContainer>
                    <Control MinHeight="20" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'job-net-menu-next-network-level'}"
                          StyleClasses="LabelKeyText" />
                        <Control MinWidth="20"/>
                        <Label Name="NextLevelLabel" Text="{Loc 'job-net-menu-standard-faction'}" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" MinHeight="100">
                        <PanelContainer VerticalExpand="True"
                                        HorizontalExpand="True"
                                   SizeFlagsStretchRatio="1"
                                   Name="NextLevelDescPC">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#000000" />
                            </PanelContainer.PanelOverride>
                            <RichTextLabel Name="NextBenefitsLabel"  VerticalExpand="True" HorizontalExpand="True"  MinHeight="100"/>
                        </PanelContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Control HorizontalExpand="True" />
                        <Label Text="{Loc 'job-net-menu-purchase-upgrade'}" StyleClasses="LabelKeyText" />
                        <Button Name="LevelPurchaseButton" Access="Public" />
                    </BoxContainer>
                </BoxContainer>
            </ScrollContainer>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical">
                    <TabContainer VerticalExpand="True" Name="RumorTabContainer">
                        <BoxContainer Name="Current" Orientation="Vertical">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                                <RichTextLabel Name="RumorLimitLbl" />
                                <Control HorizontalExpand="True" />
                                <Label Text="{Loc 'job-net-menu-next-rumor'}" StyleClasses="LabelKeyText" />
                                <RichTextLabel Name="RumorCooldownLbl" />
                            </BoxContainer>
                            <GridContainer Name="CurrentGrid" Columns="1" />
                        </BoxContainer>
                        <BoxContainer Name="Reputations" Orientation="Vertical">
                            <GridContainer Name="ReputationsGrid" Columns="2" />
                        </BoxContainer>
                        <BoxContainer Name="Imports" Orientation="Vertical">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'job-net-menu-refresh-in'}" StyleClasses="LabelKeyText" />
                                <RichTextLabel Name="RewardCooldownLbl" />
                            </BoxContainer>
                            <TabContainer VerticalExpand="True" Name="RumorRewardsTC">
                            </TabContainer>
                        </BoxContainer>
                    </TabContainer>
                </BoxContainer>
            </ScrollContainer>
            <BoxContainer Orientation="Vertical" Name="DirectMessages" Margin="10 10 10 10">
                <RichTextLabel Text="{Loc 'job-net-menu-dm-hint'}" />
                <Label Text="{Loc 'job-net-menu-conversations'}" StyleClasses="LabelKeyText"/>
                <BoxContainer Access="Public" Orientation="Vertical" Name="ActiveConversations">
                </BoxContainer>
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</DefaultWindow>